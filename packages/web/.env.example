# web の環境変数テンプレート。Vite はモードごとに env ファイルを読む。
# - ローカル開発(vite dev)   : .env.development
# - 本番ビルド(vite build)   : .env.production
# - 個人上書き(全モード最優先): .env.local（gitignore。本番ビルドも拾うので値に注意）
# Cognito 値は CDK デプロイ後の Outputs（UserPoolId / UserPoolClientId / HostedUiDomain）。

# API のベースURL（テナントのオリジン）。SPA と API は同一オリジンに同居し API は /api 配下。
# 本番は同一オリジンのため空でよい（相対 /api/... を叩く）。
# ローカル開発は別オリジンの API を指すため設定する。末尾に /api は付けない。
VITE_API_BASE_URL=https://app.example.com

VITE_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Cognito Hosted UI ドメイン。例: {authDomainPrefix}.auth.ap-northeast-1.amazoncognito.com
VITE_COGNITO_HOSTED_UI_DOMAIN=xxxxxxxx.auth.ap-northeast-1.amazoncognito.com

# OAuth リダイレクト先はコードで window.location.origin を使うため env は不要。
# 開いているオリジン（ローカル http://localhost:5173/、本番 https://{tenant}.{baseDomain}/）が
# 使われる。そのオリジンが Cognito App Client の callbackUrls/logoutUrls に含まれていること。
