# API のベースURL（テナントのオリジン）。CloudFront 経由で API Gateway に届く。
# ここを叩くことで X-Origin-Verify / X-Tenant-Id が付与され Authorizer を通る。
VITE_API_BASE_URL=https://app.example.com

# Cognito（CDK デプロイ後の Outputs UserPoolId / UserPoolClientId）
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Cognito Hosted UI ドメイン（CDK Output HostedUiDomain）。
# 例: {authDomainPrefix}.auth.ap-northeast-1.amazoncognito.com
VITE_COGNITO_HOSTED_UI_DOMAIN=xxxxxxxx.auth.ap-northeast-1.amazoncognito.com

# OAuth リダイレクト先。SPA を開くオリジン。ローカルは http://localhost:5173。
# App Client の callbackUrls / logoutUrls に含まれている必要がある。
VITE_REDIRECT_URL=http://localhost:5173
